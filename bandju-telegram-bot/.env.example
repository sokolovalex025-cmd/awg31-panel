TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Bandju Panel local API. Do not expose this port publicly.
BANDJU_API_BASE=http://127.0.0.1:7777

# Optional API authentication if your Bandju build requires it.
BANDJU_API_TOKEN=
BANDJU_API_TIMEOUT=15

# Safety: 0 = read-only (default), 1 = allow create/renew/enable/disable.
BANDJU_MUTATIONS_ENABLED=0

# Defaults
VPN_PROTOCOL=amneziawg
DEFAULT_DAYS=30

# Optional explicit endpoint overrides.
BANDJU_ACCESS_LIST_PATH=
BANDJU_ACCESS_CREATE_PATH=
BANDJU_ACCESS_GET_PATH=
BANDJU_ACCESS_RENEW_PATH=
BANDJU_ACCESS_DISABLE_PATH=
BANDJU_ACCESS_ENABLE_PATH=
