TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Bandju Panel local API. Do not expose this port publicly.
BANDJU_API_BASE=http://127.0.0.1:7777
BANDJU_API_TOKEN=
BANDJU_API_TIMEOUT=15

# Optional Bandju AmneziaWG container name.
# Leave empty to let Bandju choose its default container.
BANDJU_CONTAINER=

# Safety: 0 = read-only (default), 1 = allow confirmed client mutations.
BANDJU_MUTATIONS_ENABLED=0

# Kept for compatibility with the original bot configuration.
DEFAULT_DAYS=30
