<Window x:Class="AWGPanel.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NOVA VPN" Height="800" Width="1200" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="Window_Drop">
 <DockPanel Background="#09101A">
  <ToolBar DockPanel.Dock="Top">
   <Button x:Name="BackButton" Click="Back_Click" Content="←" Width="40"/>
   <Button x:Name="ForwardButton" Click="Forward_Click" Content="→" Width="40"/>
   <Button Click="Reload_Click" Content="⟳" Width="40"/>
   <Separator/>
   <Button Click="Import_Click" Content="＋ Импорт .conf / .ovpn" Padding="12,4"/>
   <Button Click="OpenProfiles_Click" Content="Профили" Padding="12,4" Margin="6,0,0,0"/>
   <Separator/>
   <TextBox x:Name="AddressBox" Width="540" Text="http://95.85.241.45:8080"/>
   <Button Click="Open_Click" Content="Открыть" Margin="6,0,0,0"/>
   <Button Click="Settings_Click" Content="⚙" Width="40" Margin="6,0,0,0"/>
  </ToolBar>
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <Border Grid.Row="0" Margin="10,8,10,0" Padding="12,8" CornerRadius="10" Background="#131D2A">
    <TextBlock x:Name="ImportStatus" Foreground="#B7C2D0" Text="NOVA VPN • Перетащите .conf AWG 3.1 или .ovpn сюда либо нажмите «Импорт»."/>
   </Border>
   <Grid x:Name="BrowserHost" Grid.Row="1" Margin="10"/>
  </Grid>
 </DockPanel>
</Window>